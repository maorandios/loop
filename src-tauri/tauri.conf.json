{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileRelay",
  "version": "0.1.0",
  "identifier": "com.filerelay.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FileRelay",
        "width": 420,
        "height": 560,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "FileRelay",
    "copyright": "Copyright © 2026 FileRelay",
    "category": "Utility",
    "shortDescription": "Send a file, get it back.",
    "longDescription": "FileRelay is a Windows proof of concept for sending a file to a teammate and receiving the edited copy back.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
